# LLM generation (required on Render)
GROQ_API_KEY=your_groq_key_here

# Embeddings: local (default) or gemini (lower memory, good for Render free tier)
EMBEDDING_PROVIDER=local

# Only required when EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_key_here

# ChromaDB API implementation (set automatically in Docker)
CHROMA_API_IMPL=chromadb.api.segment.SegmentAPI

# Frontend (Vercel) — set after Render deploy
# NEXT_PUBLIC_API_URL=https://rag-chatbot-api.onrender.com
